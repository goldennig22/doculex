# /opt/doculex/.env — read by docker compose (variable substitution). Never in git. chmod 600.
# Comments on their own lines only: deploy.sh reads values with grep/cut.
# Generate passwords with: openssl rand -hex 32   (hex: no characters that break a URL)

DOCULEX_IMAGE=registry.gitlab.com/<namespace>/doculex
# Rewritten by deploy.sh after each successful deploy; the version running now.
IMAGE_TAG=
# nginx proxies to 127.0.0.1:<this>. Must not be used by another app on the VPS.
DOCULEX_HOST_PORT=5100
POSTGRES_SUPERUSER_PASSWORD=
DOCULEX_DB_PASSWORD=
