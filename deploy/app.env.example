# /opt/doculex/app.env — the app's secrets, passed into the container. Never in git. chmod 600.
# DATABASE_URL, HOST, PORT, NODE_ENV and TRUST_PROXY are set in docker-compose.yml, not here.
# Comments on their own lines only.

# What /api/health checks. Answers come from Anthropic.
LLM_PROVIDER=anthropic
# From a DocuLex-only Anthropic workspace that has a monthly spend limit.
ANTHROPIC_API_KEY=
# Fallback 1. Cap it too, or a capped Anthropic quietly sends traffic here.
OPENAI_API_KEY=
# Embeddings for every question, and fallback 2.
GEMINI_API_KEY=
# openssl rand -hex 32
ADMIN_API_KEY=
# openssl rand -hex 32. Keys the hashes of anonymised names in decisions; never change it while decisions are in review.
ANONYMISATION_HMAC_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PARALLEL_CALLS=2
LLM_MODEL=claude-haiku-5-5
LLM_2ND_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=gemini-3.8-flash
MIN_SIMILARITY=0.6
# REQUIRED in production (the app refuses to boot without it): where reports on decisions are announced.
# A secret ntfy topic works as is: https://ntfy.sh/<long random name>. Anyone who knows the name can read it.
NOTIFY_URL=
