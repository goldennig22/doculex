AI_GATEWAY_API_KEY=xxxxxxxxx
DATABASE_URL=postgres://doculex:doculex@localhost:5433/doculex
LLM_PROVIDER=google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ADMIN_API_KEY=
# openssl rand -hex 32. Keys the hashes of anonymised names; never change it while decisions are in review.
ANONYMISATION_HMAC_KEY=
PORT=5000
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_PARALLEL_CALLS=2 #For free tier api key.. can increase when a paid key is taken
LLM_MODEL="claude-haiku-5-5"
LLM_2ND_MODEL="gpt-6-luna"
LLM_FALLBACK_MODEL="gemini-3.8-flash"
MIN_SIMILARITY=0.6
# Reports on decisions are POSTed there (an ntfy topic URL). Unset in development: the notice is printed instead.
NOTIFY_URL=
# Production sets it in deploy/docker-compose.prod.yml (the Docker gateway nginx connects through). Leave unset in development.
TRUST_PROXY=
# Postgres integration tests: a separate, migrated database (never the dev one), and RUN_DB_TESTS=1 to turn them on.
#   docker exec pgvector-db createdb -U doculex doculex_test
#   DATABASE_URL=postgres://doculex:doculex@localhost:5433/doculex_test npm run db:migrate
TEST_DATABASE_URL=postgres://doculex:doculex@localhost:5433/doculex_test
RUN_DB_TESTS=1