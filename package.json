{
  "name": "doculex",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/server.ts",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "documents:embed-missing": "npx tsx src/scripts/embed-missing.ts",
    "documents:evaluate-retrieval": "npx tsx src/scripts/eval-retrieval.ts",
    "documents:evaluate-answers": "npx tsx src/scripts/eval-answers.ts",
    "keys:create": "tsx src/scripts/create-api-key.ts",
    "exam": "npx tsx src/scripts/test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/openai": "^4.0.122",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "ai": "^7.0.180",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jiti": "^2.7.0",
    "pg-boss": "^12.40.0",
    "postgres": "^3.4.9",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "form-auto-content": "^3.2.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
